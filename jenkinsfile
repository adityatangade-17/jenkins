pipeline {
      agent {
        label "node1" 
        
    }
    stages {
          stage('pull') {
            steps {
                  git branch: 'main', url: 'https://github.com/adityatangade-17/devops.git'
                echo "pull sucessful"
            }
        }
        stage('Build') {
            steps {
                sh '/opt/apache-maven-3.10.0/bin/mvn clean package'
                echo "build sucessful"
            }
        }
        stage('Test') {
            steps {
                echo "test sucessful"
            }
        }
        stage('Deploy') {
            steps {
                echo "deploy sucessful"
            }
        }
    }
}
