pipeline {
    agent any
    stages {
          stage('pull') {
            steps {
                  git branch: 'main', url: 'https://github.com/adityatangade-17/devops.git'
                echo "pull sucessful"
            }
        }
        stage('Build') {
            steps {
                echo "build sucessful"
            }
        }
        stage('Test') {
            steps {
                echo "test sucessful"
            }
        }
        stage('Deploy') {
            steps {
                echo "deploy sucessful"
            }
        }
    }
}
